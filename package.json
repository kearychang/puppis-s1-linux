{
  "name": "puppis-s1-manager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "version:check": "node scripts/check-version.mjs",
    "release:check": "bash scripts/release-check.sh",
    "package:deb": "npm run release:check && tauri build --bundles deb"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "svelte": "^5.37.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "@tauri-apps/cli": "^2.8.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/svelte": "^5.2.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^24.0.0",
    "jsdom": "^26.1.0",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^8.1.5",
    "vitest": "^3.2.0"
  }
}
